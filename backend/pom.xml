<?xml version="1.0" encoding="UTF-8"?>
<!--
  CPDTS backend - minimal Spring Boot foundation with Flyway migrations.

  Scope for this phase:
    * Minimal Spring Boot application that starts, connects to PostgreSQL,
      runs/validates the Flyway migrations, and exposes GET /actuator/health.
    * NO authentication, NO business APIs, NO frontend.

  Migrations live in: backend/src/main/resources/db/migration (V1__*.sql, ...)
  and are applied identically by BOTH:
    * Spring Boot at application startup (spring.flyway.* in application.properties)
    * the Flyway Maven plugin (configuration below) through scripts\run_db.ps1

  How to run the application (from backend\, after filling in your LOCAL
  .env.backend file - never share its values):

      # set CPDTS_DB_URL, CPDTS_DB_USER, CPDTS_DB_PASSWORD from .env.backend
      # (the same three variables scripts\run_db.ps1 injects for the CLI)
      mvn spring-boot:run

  Health check: GET http://localhost:8080/actuator/health

  Versions (verified from Maven Central metadata, checked 2026-10-27):
      Spring Boot  4.1.2  (current stable release; 4.2.0-RC1 excluded)
      Flyway       13.11.1 - the flyway.version property below OVERRIDES the
                     Spring Boot BOM default (12.4.0) so the Maven plugin and
                     the application runtime use ONE identical Flyway version
      PostgreSQL   42.7.14 (identical to the Spring Boot BOM value)
      Java         21
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <!-- Provisional coordinates; rename together with later backend phases if desired. -->
    <groupId>com.cpdts</groupId>
    <artifactId>cpdts-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>CPDTS Backend</name>
    <description>Customer Payment and Debt Tracking System backend (minimal Spring Boot foundation)</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>
        <!-- Single Flyway version for Maven plugin AND application runtime. -->
        <flyway.version>13.11.1</flyway.version>
        <postgresql.version>42.7.14</postgresql.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Spring Boot 4 modular layout: Flyway auto-configuration lives here
             (starter-jdbc does NOT include it). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <!-- Required since Flyway 10+ for PostgreSQL, same reason as the
             flyway-maven-plugin dependencies below. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Executable jar (repackage goal is managed by the Spring Boot parent). -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <plugin>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-maven-plugin</artifactId>
                <version>${flyway.version}</version>

                <!--
                  JDBC driver for the Flyway plugin itself, plus the PostgreSQL
                  database support module (Flyway 10+ keeps per-database support
                  in separate artifacts; without it Flyway fails with
                  "No Flyway database plugin found to handle jdbc:postgresql").
                -->
                <dependencies>
                    <dependency>
                        <groupId>org.postgresql</groupId>
                        <artifactId>postgresql</artifactId>
                        <version>${postgresql.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.flywaydb</groupId>
                        <artifactId>flyway-database-postgresql</artifactId>
                        <version>${flyway.version}</version>
                    </dependency>
                </dependencies>

                <configuration>
                    <url>${env.CPDTS_DB_URL}</url>
                    <user>${env.CPDTS_DB_USER}</user>
                    <password>${env.CPDTS_DB_PASSWORD}</password>
                    <locations>
                        <location>filesystem:${project.basedir}/src/main/resources/db/migration</location>
                    </locations>
                    <table>flyway_schema_history</table>
                    <connectRetries>3</connectRetries>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
