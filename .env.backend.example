# Example only. Do not assume the database exists.
# Configure only after database setup is approved.
DB_HOST=localhost
DB_PORT=5432
# Development database (created manually by the project owner; never touched by scripts).
DB_NAME=cpdts_dev
# Disposable test database (created by scripts/create_local_databases.sql only if missing).
DB_TEST_NAME=cpdts_test
# Local PostgreSQL login role used by scripts/run_db.ps1 (migrations and tests).
# Placeholder: replace with YOUR local PostgreSQL user (commonly "postgres")
# in your own local copy. Never commit real credentials.
# NOTE: "cpdts_app" is the FUTURE least-privilege application role planned for
# a later approved phase. It has NOT been created yet - do not use it here.
DB_USER=REPLACE_WITH_YOUR_LOCAL_POSTGRES_USER
DB_PASSWORD=REPLACE_LOCALLY_DO_NOT_COMMIT
